{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "ConnectionStrings": {
        "DefaultConnection": "Host=YOUR_HOST;Database=YOUR_DATABASE;Username=YOUR_USERNAME;Password=YOUR_PASSWORD"
    },
    "JwtSettings": {
        "SecretKey": "YOUR_SECRET_KEY",
        "Issuer": "CorpMindAI",
        "Audience": "CorpMindAI.Client",
        "AccessTokenExpirationMinutes": 60,
        "RefreshTokenExpirationDays": 7
    },
    "StorageSettings": {
        "UploadPath": "uploads"
    },
    "UploadSettings": {
        "MaxFileSizeBytes": 20971520,
        "MaxFilesPerRequest": 10,
        "AllowedContentTypes": [ "application/pdf" ],
        "AllowedExtensions": [ ".pdf" ]
    },
    "OcrSettings": {
        "ServiceUrl": "http://localhost:8000",
        "TimeoutSeconds": 300
    },
    "OpenAI": {
        "Embeddings": {
            "Endpoint": "https://api.openai.com/v1/",
            "Model": "text-embedding-3-small",
            "Dimensions": 1536,
            "BatchSize": 64,
            "TimeoutSeconds": 90
        },
        "Translation": {
            "Model": "gpt-4.1-mini",
            "MaxOutputTokens": 512,
            "TimeoutSeconds": 30
        },
        "Answer": {
            "Model": "gpt-4.1-mini",
            "MaxOutputTokens": 700,
            "TimeoutSeconds": 60
        }
    },
    "Qdrant": {
        "CollectionName": "corp_mind_ai_child_chunks_v1",
        "VectorSize": 1536,
        "Distance": "Cosine",
        "TimeoutSeconds": 60
    },
    "EmbeddingIndexing": {
        "BatchSize": 64,
        "DispatchBatchSize": 5
    },
    "SemanticSearch": {
        "CandidateLimit": 20,
        "MinimumScore": null,
        "EnableTranslationFallback": true,
        "TranslationFallbackScoreThreshold": 0.25
    },
    "Rag": {
        "MaxContextChunks": 5,
        "MaxContextCharacters": 24000,
        "MinimumRelevantScore": 0.25
    },
    "HangfireSettings": {
        "ServerName": "YOUR_SERVER_NAME",
        "WorkerCount": 5,
        "Queues": [ "default", "processing", "embedding" ]
    },
    "Chunking": {
        "ParentTargetTokens": 1200,
        "ParentMaxTokens": 2000,
        "ParentMinTokens": 200,
        "ChildTargetTokens": 350,
        "ChildMaxTokens": 500,
        "ChildOverlapTokens": 60,
        "MinimumSourceCoverage": 1.0,
        "TokenizerEncoding": "cl100k_base",
        "ChunkerVersion": "6.0"
    }
}
